#!/usr/bin/env python3
# -*- coding: utf-8 -*-
r"""
nyacat ── 能输出图片的 lolcat（改编自 busyloop/lolcat 100.0.1）

彩虹算法与原版逐字节一致（对照系统安装的 gem 源码 lib/lolcat/lol.rb 实现），
并在此基础上增加：

  1. 转义序列感知：kitty 图形协议(APC)、sixel(DCS)、OSC 等原样直通，图片不被破坏
  2. 运行模式：给子命令分配伪终端(pty)并双向代理，fastfetch 等以为在真终端里，
     会照常输出图片；终端对尺寸查询(\e[14t/\e[18t)的应答也能透传回去
  3. 图片模式：直接显示本地图片（kitty 图形协议 / iTerm2 OSC1337）

用法:
  somecmd | nyacat                    # 过滤模式：彩虹化 stdin（等价 lolcat）
  nyacat FILE...                      # 彩虹化文本文件
  nyacat -c fastfetch                 # 运行模式：fastfetch 图片 + 彩虹字
  nyacat -c fish -c f                 # 运行模式也能包 fish 函数（如看板娘 f）
  nyacat neko.png [mimi.jpg ...]      # 图片模式：直接显示图片 + 彩虹文件名

选项（与 lolcat 相同）:
  -p, --spread F   彩虹宽度（默认 3.0）
  -F, --freq F     彩虹频率（默认 0.1）
  -S, --seed N     彩虹种子，0=随机（默认 0）
  -a, --animate    霓虹闪烁动画
  -d, --duration N 动画帧数（默认 12）
  -s, --speed F    动画帧率（默认 20.0）
  -i, --invert     前景/背景反转
  -t, --truecolor  强制 24 位色（默认按 COLORTERM 自动检测，否则 256 色）
  -f, --force      stdout 非终端时也强制上色（否则原样直通，同 lolcat）
nyacat 附加:
  -c, --command CMD  运行模式：在伪终端里跑 CMD 并彩虹化其输出
  --proto P          图片协议 auto|kitty|iterm（默认 auto）
  -q, --quiet        图片模式下不打印文件名
  --image            强制按图片处理文件参数
"""
import argparse
import base64
import codecs
import fcntl
import math
import os
import random
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import time
import tty

try:
    import pty as _pty
except ImportError:
    _pty = None

TRUECOLOR = 0xFFFFFF


# ---------------------------------------------------------------- 彩虹引擎 --
def rainbow(freq, i):
    """与 lol.rb#rainbow 完全一致的 sin 三相移公式（截断取整）。"""
    r = int(math.sin(freq * i + 0.0) * 127 + 128)
    g = int(math.sin(freq * i + 2 * math.pi / 3) * 127 + 128)
    b = int(math.sin(freq * i + 4 * math.pi / 3) * 127 + 128)
    return r, g, b


def rgb_to_256(r, g, b):
    """Paint gem rgb_to_256 的 1:1 移植（灰度/立方体量化）。"""
    gray_possible, sep, gray = True, 42.5, True
    while gray_possible:
        if r < sep or g < sep or b < sep:
            gray = r < sep and g < sep and b < sep
            gray_possible = False
        sep += 42.5
    if gray:
        return 232 + int(math.floor((r + g + b) / 33.0 + 0.5))
    return 16 + int(6 * (r / 256.0)) * 36 + int(6 * (g / 256.0)) * 6 + int(6 * (b / 256.0))


class Painter:
    def __init__(self, truecolor=None, invert=False):
        # 与 lol.rb#set_mode 一致：-t 强制真彩，否则看 COLORTERM，再否则 256 色
        if truecolor:
            self.mode = TRUECOLOR
        elif str(os.environ.get("COLORTERM", "")).lower() in ("truecolor", "24bit"):
            self.mode = TRUECOLOR
        else:
            self.mode = 256
        self.invert = invert
        self._cache = {}

    def sgr(self, r, g, b):
        key = (r, g, b)
        code = self._cache.get(key)
        if code is None:
            if self.invert:
                code = (
                    f"\x1b[48;2;{r};{g};{b}m", b"\x1b[49m"
                ) if self.mode == TRUECOLOR else (
                    f"\x1b[48;5;{rgb_to_256(r, g, b)}m", b"\x1b[49m"
                )
            else:
                code = (
                    f"\x1b[38;2;{r};{g};{b}m", b"\x1b[39m"
                ) if self.mode == TRUECOLOR else (
                    f"\x1b[38;5;{rgb_to_256(r, g, b)}m", b"\x1b[39m"
                )
            self._cache[key] = code
        return code


# --------------------------------------------------------- lolcat 式过滤器 --
# 与 lol.rb#println_plain 相同的“配对”模型：
#   scan 把每行切成 (转义序列连跑, 单个可见字符) 配对；配对序号 i 决定颜色：
#   rainbow(freq, os + i/spread)；os 每行 +1（首行从 seed+1 开始）。
# 输出顺序：转义连跑原样 → 颜色 → 字符 → \e[39m（逐配对复位，含空字符配对）。
class LolcatFilter:
    CSI_STRIP_ANI = re.compile(rb"\x1b\[[0-?]*[@JKPX]")

    def __init__(self, out, freq, spread, seed, painter,
                 animate=False, duration=12, speed=20.0):
        self.out = out
        self.freq = freq
        self.spread = max(spread, 0.1)
        self.os = seed + 1          # cat() 每行先 os+=1，首行即 seed+1
        self.painter = painter
        self.animate = animate
        self.duration = duration
        self.speed = speed
        self.state = "ground"       # 转义序列状态机（ground/esc/csi/osc/osc_esc/str）
        self.run = bytearray()      # 收集中的转义连跑
        self.str_esc = False
        self.txt = bytearray()
        self.dec = codecs.getincrementaldecoder("utf-8")("replace")
        self.i = 0                  # 当前行配对序号
        self.run_emitted = False    # 转义序列已即时直通（不等下一字符）
        self.line = bytearray()     # animate 模式整行缓存 (run_or_char 标记)
        self.saw_nl = False

    # ---- 基础输出 ----
    def _write(self, data):
        self.out.write(data)

    def _color_sgr(self):
        r, g, b = rainbow(self.freq, self.os + self.i / self.spread)
        return self.painter.sgr(r, g, b)

    # ---- 一个配对：转义连跑(可空) + 单个字符(可空) ----
    def _pair(self, char):
        run = b""
        if self.run_emitted:
            self.run_emitted = False    # 已即时写出，字节顺序仍与 lolcat 一致
        elif self.run:
            run = bytes(self.run)
            self.run = bytearray()
        if self.animate:
            self.line.append((run, char))
            return
        self._write_pair(run, char, self.i)
        self.i += 1

    # 转义序列完结即直通：查询/图片协议必须立刻到达终端，
    # 否则子进程等应答、缓冲等字符，互相死锁到超时（animate 保持整行缓冲除外）
    def _seq_done(self):
        if not self.animate and self.run:
            self._write(bytes(self.run))
            self.run = bytearray()
            self.run_emitted = True

    def _write_pair(self, run, char, idx, frame_strip=False):
        if frame_strip and run:
            run = self.CSI_STRIP_ANI.sub(b"", run)
        if run:
            self._write(run)
        r, g, b = rainbow(self.freq, self.os + idx / self.spread)
        sgr, reset = self.painter.sgr(r, g, b)
        self._write(sgr.encode())
        if char:
            self._write(char.encode("utf-8", "replace"))
        self._write(reset)

    # ---- 行收尾：scan 对每行都会多出一个“空尾配对”，换行后 os+=1 ----
    def _endline(self, chomped=True):
        self._pair("")
        if self.animate:
            self._animate_line()
        if chomped:
            self._write(b"\n")
        self.os += 1
        self.i = 0
        self.saw_nl = True

    def _animate_line(self):
        # println_ani：\e7 存光标 → duration 帧（\e8 回光标，os+=spread 重绘）
        if not self.line:
            return
        real_os = self.os
        self._write(b"\x1b7")
        for frame in range(self.duration):
            self._write(b"\x1b8")
            self.os += self.spread
            for idx, (run, char) in enumerate(self.line):
                self._write_pair(run, char, idx, frame_strip=frame > 0)
                self.out.flush()
            time.sleep(1.0 / self.speed)
        self.os = real_os
        self.line = bytearray()

    # ---- 文本落盘 ----
    def _flush_text(self):
        if not self.txt:
            return
        s = self.dec.decode(bytes(self.txt), final=False)
        self.txt.clear()
        for ch in s:
            if ch == "\n":
                self._endline()
            elif ch == "\t":
                for _ in range(8):  # println 里 tab 展开成 8 个独立空格配对
                    self._pair(" ")
            else:
                self._pair(ch)

    # ---- 转义序列状态机（序列进 run，原样直通）----
    def feed(self, data):
        for byte in data:
            st = self.state
            if st == "ground":
                if byte == 0x1B:
                    self._flush_text()
                    self.state = "esc"
                else:
                    self.txt.append(byte)
            elif st == "esc":
                if byte == ord("["):
                    self.state = "csi"
                    self.run += b"\x1b["
                elif byte == ord("]"):
                    self.state = "osc"
                    self.run += b"\x1b]"
                elif byte in (0x50, 0x58, 0x5E, 0x5F):  # DCS/SOS/PM/APC（图片协议）
                    self.state = "str"
                    self.str_esc = False
                    self.run += b"\x1b" + bytes([byte])
                else:
                    self.state = "ground"
                    self.run += b"\x1b" + bytes([byte])
                    self._seq_done()  # 2 字符转义并入下一个配对
            elif st == "csi":
                self.run.append(byte)
                if 0x40 <= byte <= 0x7E:
                    self.state = "ground"
                    self._seq_done()
            elif st == "osc":
                self.run.append(byte)
                if byte == 0x07:
                    self.state = "ground"
                    self._seq_done()
                elif byte == 0x1B:
                    self.state = "osc_esc"
            elif st == "osc_esc":
                self.run.append(byte)
                if byte == ord("\\"):
                    self.state = "ground"
                    self._seq_done()
                else:
                    self.state = "osc"
            elif st == "str":
                self.run.append(byte)
                if self.str_esc:
                    if byte == ord("\\"):  # ST：图片载荷结束
                        self.state = "ground"
                        self._seq_done()
                    else:
                        self.str_esc = byte == 0x1B
                elif byte == 0x1B:
                    self.str_esc = True
        self.out.flush()

    def finish(self):
        self._flush_text()
        if not self.animate and self.state != "ground" and self.run:
            self.run = bytearray()  # 末尾残缺的转义序列：按 lolcat 行为丢弃
        if not self.saw_nl:  # 末行无换行符：补 scan 空尾配对 + chomped==nil 的 os 推进
            self._pair("")
            if self.animate:
                self._animate_line()
            self.os += self.i / self.spread
        if sys.stdout.isatty():
            self._write(b"\x1b[m\x1b[?25h\x1b[?1;5;2004l")
        self.out.flush()


# --------------------------------------------------------------- 运行模式 --
def copy_winsize(dst_fd):
    try:
        ws = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        if ws != b"\0" * 8:
            fcntl.ioctl(dst_fd, termios.TIOCSWINSZ, ws)
    except OSError:
        pass


def run_mode(cmd, flt):
    """在伪终端里跑 cmd，stdout 彩虹转发，stdin 原样透传（查询应答的通路）。"""
    if _pty is None:
        sys.exit("nyacat: 运行模式需要 Unix pty 支持")
    mfd, sfd = _pty.openpty()
    copy_winsize(sfd)
    try:
        tty.setraw(sfd)
    except termios.error:
        pass

    def preexec():
        os.setsid()
        try:
            fcntl.ioctl(sfd, termios.TIOCSCTTY, 0)
        except OSError:
            pass

    proc = subprocess.Popen(
        cmd, stdin=sfd, stdout=sfd, stderr=sfd,
        preexec_fn=preexec, close_fds=True,
    )
    os.close(sfd)

    real_stdin = sys.stdin.fileno()
    saved_termios = None
    try:
        saved_termios = termios.tcgetattr(real_stdin)
        tty.setraw(real_stdin)  # 让终端的查询应答不经行缓冲直达子进程
    except (termios.error, OSError):
        pass

    rc = 0
    try:
        fds = [mfd]
        if saved_termios is not None:
            fds.append(real_stdin)
        while True:
            r, _, _ = select.select(fds, [], [], 0.02)
            if mfd in r:
                try:
                    data = os.read(mfd, 65536)
                except OSError:
                    break
                if not data:
                    break
                flt.feed(data)
            if real_stdin in r:
                try:
                    data = os.read(real_stdin, 65536)
                except OSError:
                    data = b""
                if data:
                    os.write(mfd, data)
                else:
                    fds.remove(real_stdin)
            if proc.poll() is not None and mfd not in r:
                r2, _, _ = select.select([mfd], [], [], 0.05)
                if not r2:
                    break
    except KeyboardInterrupt:
        proc.terminate()
    finally:
        try:
            while True:
                r, _, _ = select.select([mfd], [], [], 0.05)
                if not r:
                    break
                data = os.read(mfd, 65536)
                if not data:
                    break
                flt.feed(data)
        except OSError:
            pass
        flt.finish()
        if saved_termios is not None:
            termios.tcsetattr(real_stdin, termios.TCSADRAIN, saved_termios)
        rc = proc.wait()
    return rc


# --------------------------------------------------------------- 图片模式 --
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
IMAGE_MAGICS = (
    (PNG_MAGIC, "png"),
    (b"\xff\xd8\xff", "jpg"),
    (b"GIF8", "gif"),
    (b"BM", "bmp"),
)


def sniff_image(head):
    for magic, _ in IMAGE_MAGICS:
        if head.startswith(magic):
            return True
    return head[:4] == b"RIFF" and head[8:12] == b"WEBP"


def png_size(png):
    return struct.unpack(">II", png[16:24])


def cell_pixels():
    try:
        res = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xpix, ypix = struct.unpack("HHHH", res)
        if xpix > 0 and ypix > 0 and rows > 0 and cols > 0:
            return max(xpix // cols, 1), max(ypix // rows, 1)
    except (OSError, struct.error):
        pass
    return 9, 18


def terminal_cells():
    try:
        res = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, _, _ = struct.unpack("HHHH", res)
        if rows > 0 and cols > 0:
            return rows, cols
    except (OSError, struct.error):
        pass
    return 24, 80


def as_png(data, path):
    """统一转 PNG（kitty 协议只吃 PNG），超终端 80% 则缩放。"""
    cw, chh = cell_pixels()
    rows, cols = terminal_cells()
    max_w, max_h = int(cols * cw * 0.8), int(rows * chh * 0.8)

    if data.startswith(PNG_MAGIC):
        w, h = png_size(data)
        if w <= max_w and h <= max_h:
            return data, w, h

    try:
        from PIL import Image  # type: ignore
        import io

        im = Image.open(io.BytesIO(data))
        im = im.convert("RGBA")
        w, h = im.size
        scale = min(max_w / w, max_h / h, 1.0)
        if scale < 1.0:
            im = im.resize((max(int(w * scale), 1), max(int(h * scale), 1)),
                           Image.LANCZOS)
        buf = io.BytesIO()
        im.save(buf, "PNG")
        out = buf.getvalue()
        return out, *png_size(out)
    except Exception:
        pass

    if data.startswith(PNG_MAGIC):
        return data, *png_size(data)
    raise SystemExit(f"nyacat: 无法解码 {path}（需要 Pillow 或改用 PNG）")


def send_kitty(out, png):
    """kitty 图形协议：PNG base64 分块传输，C=1 固定光标，显示完手动换行。"""
    b64 = base64.b64encode(png)
    chunk = 4096
    pieces = [b64[i:i + chunk] for i in range(0, len(b64), chunk)] or [b""]
    for n, piece in enumerate(pieces):
        head = b"\x1b_Ga=T,f=24,q=2,C=1"
        if len(pieces) > 1:
            head += b",m=" + (b"1" if n < len(pieces) - 1 else b"0")
        out.write(head + b";" + piece + b"\x1b\\")
    _, h = png_size(png)
    _, chh = cell_pixels()
    out.write(b"\r" + b"\n" * max(1, round(h / chh)))


def send_iterm(out, data, path):
    name = base64.b64encode(os.path.basename(path).encode()).decode()
    out.write(
        f"\x1b]1337;File=inline=1;size={len(data)};preserveAspectRatio=1;"
        f"name={name}:{base64.b64encode(data).decode()}\x07".encode()
    )
    out.write(b"\n")


def pick_proto(want):
    if want != "auto":
        return want
    env = os.environ.get("TERM", "") + " " + os.environ.get("TERM_PROGRAM", "")
    if re.search(r"wezterm|iTerm|mintty", env, re.I):
        return "iterm"
    return "kitty"


def image_mode(paths, flt, proto_want, quiet):
    out = sys.stdout.buffer
    proto = pick_proto(proto_want)
    for path in paths:
        try:
            data = open(path, "rb").read()
        except OSError as e:
            print(f"nyacat: 读不了 {path}: {e}", file=sys.stderr)
            continue
        if proto == "kitty":
            png, _, _ = as_png(data, path)
            send_kitty(out, png)
        else:
            send_iterm(out, data, path)
        out.flush()
        if not quiet:
            flt.feed(f"  {path}\n".encode())
    flt.finish()


# -------------------------------------------------------------------- CLI --
def main():
    ap = argparse.ArgumentParser(
        prog="nyacat",
        description="能输出图片的 lolcat（彩虹与 lolcat 100.0.1 逐字节一致）",
    )
    ap.add_argument("-p", "--spread", type=float, default=3.0)
    ap.add_argument("-F", "--freq", type=float, default=0.1)
    ap.add_argument("-S", "--seed", type=int, default=0)
    ap.add_argument("-a", "--animate", action="store_true")
    ap.add_argument("-d", "--duration", type=float, default=12)
    ap.add_argument("-s", "--speed", type=float, default=20.0)
    ap.add_argument("-i", "--invert", action="store_true")
    ap.add_argument("-t", "--truecolor", action="store_true")
    ap.add_argument("-f", "--force", action="store_true")
    ap.add_argument("-c", "--command", nargs=argparse.REMAINDER, metavar="CMD")
    ap.add_argument("--proto", choices=["auto", "kitty", "iterm"], default="auto")
    ap.add_argument("-q", "--quiet", action="store_true")
    ap.add_argument("--image", action="store_true")
    ap.add_argument("files", nargs="*")
    opts = ap.parse_args()

    out = sys.stdout.buffer
    colorize = sys.stdout.isatty() or opts.force

    cmd = opts.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if cmd:
        if not colorize:
            # 与 lolcat 一致：非 tty 且未 -f 时原样直通
            proc = subprocess.Popen(cmd)
            proc.wait()
            sys.exit(proc.returncode)
        seed = opts.seed if opts.seed != 0 else random.randint(0, 255)
        flt = LolcatFilter(out, opts.freq, opts.spread, seed,
                           Painter(opts.truecolor, opts.invert),
                           opts.animate, int(opts.duration), opts.speed)
        sys.exit(run_mode(cmd, flt))

    if not colorize:
        shutil.copyfileobj(sys.stdin.buffer, out)  # 原样直通
        return

    images, texts = [], []
    for path in opts.files:
        try:
            with open(path, "rb") as fh:
                head = fh.read(16)
        except OSError:
            head = b""
        if opts.image or sniff_image(head):
            images.append(path)
        else:
            texts.append(path)

    seed = opts.seed if opts.seed != 0 else random.randint(0, 255)
    flt = LolcatFilter(out, opts.freq, opts.spread, seed,
                       Painter(opts.truecolor, opts.invert),
                       opts.animate, int(opts.duration), opts.speed)

    if images:
        image_mode(images, flt, opts.proto, opts.quiet)
        if not texts:
            return

    for path in texts:
        try:
            with open(path, "rb") as fh:
                while chunk := fh.read(65536):
                    flt.feed(chunk)
        except OSError as e:
            print(f"nyacat: {e}", file=sys.stderr)
    if not texts:
        while chunk := sys.stdin.buffer.read(65536):
            flt.feed(chunk)
        flt.finish()
    else:
        flt.finish()


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    main()
